  "tour": [
    {
      "order": 1,
      "title": "Project Overview",
      "description": "Start with the README to understand what Dev-IA-Team is — a context orchestrator that simulates a software engineering team using AI agents. Learn what the framework does (and crucially, what it doesn't do).",
      "nodeIds": ["document:README.md"]
    },
    {
      "order": 2,
      "title": "The Supervisor — Central Orchestrator",
      "description": "The Supervisor is the entry point for all work. It receives a user 'wish', plans which pods to activate in what order (sequential vs parallel), and generates the exact shell commands needed. Read SUPERVISOR.md to understand its orchestration directives.",
      "nodeIds": ["document:agents/SUPERVISOR.md", "document:agents/pods/supervisor/PROMPT.md"]
    },
    {
      "order": 3,
      "title": "Core Activation Script",
      "description": "activate.sh is the heart of the framework. It loads a pod's PROMPT.md, the shared project context, inter-pod artifacts, and the pod's persistent memory — assembling them into a structured prompt ready to paste into any AI chat.",
      "nodeIds": ["file:agents/activate.sh"]
    },
    {
      "order": 4,
      "title": "Specialist Pod Roles",
      "description": "Each pod has a PROMPT.md defining its role, competencies, and output formats. The six specialists are: Product Owner (roadmap/stories), Backend (APIs/DB), Frontend (UI/components), QA (tests/quality gates), Security (OWASP/JWT), and DevOps (CI-CD/infra).",
      "nodeIds": [
        "document:agents/pods/po/PROMPT.md",
        "document:agents/pods/backend/PROMPT.md",
        "document:agents/pods/frontend/PROMPT.md",
        "document:agents/pods/qa/PROMPT.md",
        "document:agents/pods/sec/PROMPT.md",
        "document:agents/pods/devops/PROMPT.md"
      ]
    },
    {
      "order": 5,
      "title": "Shared Project Context",
      "description": "context/shared/project.md is injected into every pod activation. It defines the current project (TaskFlow), tech stack, architectural decisions, and coding standards — ensuring all AI agents operate with the same ground truth.",
      "nodeIds": ["document:agents/context/shared/project.md"]
    },
    {
      "order": 6,
      "title": "Persistent Pod Memory",
      "description": "Each pod has a memory.md that records its task history across sessions. update_memory.sh appends AI output summaries, archive_memory.sh trims old entries, and status.sh displays the full history — implementing session persistence without a database.",
      "nodeIds": [
        "file:agents/update_memory.sh",
        "file:agents/archive_memory.sh",
        "file:agents/status.sh",
        "document:agents/pods/po/memory.md",
        "document:agents/pods/backend/memory.md"
      ]
    },
    {
      "order": 7,
      "title": "Chain Workflows",
      "description": "run_chain.sh executes .chain files that define multi-pod workflows. The auth.chain shows a complete 4-step workflow: PO → Backend+Frontend (parallel) → QA+Security (parallel) → DevOps, demonstrating the sequential/parallel orchestration model.",
      "nodeIds": [
        "file:agents/run_chain.sh",
        "config:agents/chains/auth.chain",
        "config:agents/chains/ecommerce.chain",
        "config:agents/chains/saas-mvp.chain"
      ]
    },
    {
      "order": 8,
      "title": "Quality & Health Checks",
      "description": "doctor.sh validates the full framework setup (scripts, pod files, chains). The smoke test suite and CI pipeline ensure all shell scripts pass shellcheck and behavioral tests on every push.",
      "nodeIds": [
        "file:agents/doctor.sh",
        "file:agents/tests/run_smoke_tests.sh",
        "pipeline:.github/workflows/shell-ci.yml"
      ]
    },
    {
      "order": 9,
      "title": "Step-by-Step Tutorial",
      "description": "PASSO-A-PASSO.md walks through a complete real-world scenario using the TaskFlow project — from Supervisor planning to PO, Backend, QA, and DevOps activations — the best way to understand the full workflow in practice.",
      "nodeIds": ["document:PASSO-A-PASSO.md"]
    }
  ]
